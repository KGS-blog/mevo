<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Aplikasi Web GAS & Google Sheets</title>
  <!-- Framework CSS Tailwind untuk Tampilan -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 min-h-screen p-4 md:p-8 font-sans">

  <div class="max-w-4xl mx-auto space-y-8">
    
    <!-- HEADER -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
      <h1 class="text-2xl font-bold text-slate-800">Formulir Input Data</h1>
      <p class="text-slate-500 text-sm mt-1">Data yang diisi akan tersimpan langsung ke Google Sheets melalui Google Apps Script.</p>
    </div>

    <!-- FORM INPUT (POST) -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
      <form id="dataForm" onsubmit="submitData(event)" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Nama Lengkap</label>
          <input type="text" id="nama" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none text-slate-800" placeholder="Masukkan nama">
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Alamat Email</label>
          <input type="email" id="email" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none text-slate-800" placeholder="nama@email.com">
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Pesan / Catatan</label>
          <textarea id="pesan" rows="3" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none text-slate-800" placeholder="Tuliskan pesan..."></textarea>
        </div>

        <button type="submit" id="btnSubmit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition-colors flex items-center justify-center space-x-2">
          <span>Kirim Data</span>
        </button>
      </form>

      <!-- Status Notifikasi -->
      <div id="statusMessage" class="hidden mt-4 p-3 rounded-lg text-sm text-center"></div>
    </div>

    <!-- TABEL DATA (GET) -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-lg font-bold text-slate-800">Data Terdaftar</h2>
        <button onclick="loadData()" class="text-sm bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-lg border border-slate-300 transition-colors">
          Refresh Data
        </button>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-slate-600 text-xs uppercase tracking-wider">
              <th class="p-3">Waktu</th>
              <th class="p-3">Nama</th>
              <th class="p-3">Email</th>
              <th class="p-3">Pesan</th>
            </tr>
          </thead>
          <tbody id="tableBody" class="text-sm text-slate-700 divide-y divide-slate-100">
            <tr>
              <td colspan="4" class="p-4 text-center text-slate-400">Memuat data...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <script>
    // MASUKKAN WEB APP URL DARI GOOGLE APPS SCRIPT ANDA DI SINI
    const GAS_URL = "https://script.google.com/macros/s/AKfycbzwtETHfx8zHfPr_NpZI0LJ68mQjMMiQVZYiz2gct9cmS7_JXJgWBmrbrdTnfyCpw/exec";

    // 1. Fungsi Kirim Data (POST)
    async function submitData(event) {
      event.preventDefault();

      const btnSubmit = document.getElementById("btnSubmit");
      const statusMessage = document.getElementById("statusMessage");

      const payload = {
        nama: document.getElementById("nama").value,
        email: document.getElementById("email").value,
        pesan: document.getElementById("pesan").value
      };

      // Set State Loading
      btnSubmit.disabled = true;
      btnSubmit.innerText = "Lagi Menyimpan...";
      statusMessage.className = "mt-4 p-3 rounded-lg text-sm text-center bg-blue-50 text-blue-700 block";
      statusMessage.innerText = "Mengirim data ke Google Sheets...";

      try {
        const response = await fetch(GAS_URL, {
          method: "POST",
          headers: {
            "Content-Type": "text/plain;charset=utf-8"
          },
          body: JSON.stringify(payload)
        });

        const result = await response.json();

        if (result.result === "success") {
          statusMessage.className = "mt-4 p-3 rounded-lg text-sm text-center bg-emerald-50 text-emerald-700 block";
          statusMessage.innerText = "Data berhasil tersimpan!";
          document.getElementById("dataForm").reset();
          loadData(); // Update tabel otomatis
        } else {
          throw new Error(result.error || "Gagal menyimpan data.");
        }
      } catch (err) {
        statusMessage.className = "mt-4 p-3 rounded-lg text-sm text-center bg-rose-50 text-rose-700 block";
        statusMessage.innerText = "Terjadi Kesalahan: " + err.message;
      } finally {
        btnSubmit.disabled = false;
        btnSubmit.innerText = "Kirim Data";
      }
    }

    // 2. Fungsi Ambil Data (GET)
    async function loadData() {
      const tableBody = document.getElementById("tableBody");
      tableBody.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-slate-400">Memuat data terbaru...</td></tr>`;

      try {
        const response = await fetch(GAS_URL);
        const result = await response.json();

        if (result.result === "success" && result.data.length > 0) {
          tableBody.innerHTML = result.data.map(row => `
            <tr class="hover:bg-slate-50">
              <td class="p-3 text-xs text-slate-500">${row.Timestamp ? new Date(row.Timestamp).toLocaleString('id-ID') : '-'}</td>
              <td class="p-3 font-medium">${row.nama || '-'}</td>
              <td class="p-3">${row.email || '-'}</td>
              <td class="p-3">${row.pesan || '-'}</td>
            </tr>
          `).join("");
        } else {
          tableBody.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-slate-400">Belum ada data tersimpan.</td></tr>`;
        }
      } catch (err) {
        tableBody.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-rose-500">Gagal mengambil data dari server.</td></tr>`;
      }
    }

    // Muat data saat halaman pertama kali dibuka
    window.addEventListener("DOMContentLoaded", loadData);
  </script>
</body>
</html>
